# Production environment template for Dokploy / Docker Compose deploys.
# Copy to .env and fill in real values. NEVER commit the filled .env.

# ---- Database ----
POSTGRES_USER=sunseekers
POSTGRES_DB=sunseekers
# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Auth secrets ----
# Required. Must each be at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Seed admin (used only when the database is first seeded) ----
ADMIN_EMAIL=admin@sunseeker.local
ADMIN_PASSWORD=

# ---- Jetpack CRM / WordPress migration (optional) ----
JETPACK_CRM_ENABLED=false
JETPACK_CRM_ENDPOINT=https://sunseekerstours.com/zbs_api/
JETPACK_CRM_API_KEY=
JETPACK_CRM_API_SECRET=
