# Build context excludes. Keep images small and avoid leaking local secrets.
.git
.gitignore
**/node_modules
**/.next
**/dist
**/.turbo
**/*.tsbuildinfo

# Local secrets and env files
.env
.env.*
!.env.example

# Logs and dev artifacts
*.log
web_out.txt
web_err.txt
boot*.log
boot*.txt
smoke-*.log
smoke-*.txt
e2e-*.log
bk*.txt

# Docs and bundles not needed at build time
*.docx
sunseekers-bundle.tar.gz
docs/

# Tests and mobile app are not part of the server build
apps/mobile
**/*.spec.ts
**/*.e2e-spec.ts
