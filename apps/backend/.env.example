# Copy to .env and adjust for your environment. Never commit real secrets.

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Security ---
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TTL=3600

# --- Database ---
DATABASE_URL=postgresql://sunseekers:sunseekers@localhost:5432/sunseekers?schema=public

# --- Cache / Queue (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Logging ---
LOG_LEVEL=info
LOG_JSON=false

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# --- Initial admin (seeded) ---
ADMIN_EMAIL=admin@sunseeker.local
ADMIN_PASSWORD=ChangeMe123!

# --- Object Storage (future) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
